# Wird von install.sh nach ".env" kopiert. Keys eintragen, ".env" NIE auf GitHub hochladen.
# Mehrere Keys pro Anbieter mit Komma trennen -> automatische Rotation bei Limit (429).

# Claude (API-Key von console.anthropic.com, Modelle waehlst du pro Agent: Sonnet, Haiku, Opus ...)
ANTHROPIC_API_KEY=
# ChatGPT (API-Key von platform.openai.com)
OPENAI_API_KEY=
# OpenRouter: ein Key fuer hunderte Modelle (Claude, GPT, Gemini, DeepSeek, Qwen, Llama ...)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# Weitere Anbieter (alle optional, Modell je Agent in der Oberflaeche):
# MISTRAL_API_KEY=        # console.mistral.ai (Gratis-Stufe "Experiment")
# NVIDIA_API_KEY=         # build.nvidia.com, Schluessel beginnt mit nvapi-
# TOGETHER_API_KEY=       # api.together.ai
# PERPLEXITY_API_KEY=     # Modelle sonar/sonar-pro mit eingebauter Websuche
# HF_TOKEN=               # huggingface.co/settings/tokens (Inference-Rechte), kleines Gratis-Guthaben je Monat
# CF_ACCOUNT_ID=          # Cloudflare Workers AI: Konto-ID ...
# CF_API_TOKEN=           # ... und API-Token mit "Workers AI"-Recht (Gratis-Kontingent je Tag)

# Ollama (lokal auf dem Pi, optional)
# Laeuft Ollama auf einem anderen Rechner (z.B. Laptop), dessen Adresse eintragen und dort OLLAMA_HOST=0.0.0.0 setzen.
# OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
# OLLAMA_MODEL=qwen2.5:3b         # bei nur ~2 GB freiem RAM: qwen2.5:1.5b
# PCL_SITE_HOST=127.0.0.1       # Veroeffentlichte Webseiten: nur Pi (Standard) oder 0.0.0.0 fuer das Netz
# PCL_SITE_PORT_BASE=8800       # erster Port fuer veroeffentlichte Webseiten
# PCL_TZ=Europe/Vienna          # Zeitzone fuer Oeffnungszeiten/Zeitplaene, falls die Systemzeit nicht passt
# PCL_MAX_RESUMES=2             # Wiederaufnahmen je gescheiterter Aufgabe bei Arbeitsbeginn
# PCL_MODEL_CHECK_HOURS=6      # Modell-Pruefung gegen die Anbieter-Listen (0 = aus); Warnung per Telegram + Menue ⚠ Modelle
# OLLAMA_TIMEOUT=1800         # Sekunden OHNE neue Daten (Modell laden, Prompt lesen); solange Ollama schreibt, bricht nichts ab
# OLLAMA_MAX_TIME=7200         # Gesamtzeit je Ollama-Antwort in Sekunden, 0 = ohne Grenze

# --- Zugang ---
# Passwort fuer die Login-Seite (install.sh setzt ein zufaelliges). Mindestens 12 Zeichen,
# sobald die App von aussen erreichbar ist.
APP_TOKEN=

# Standard: nur lokal (127.0.0.1). Fuer Tailscale/Cloudflare Tunnel bleibt das so.
# HOST=0.0.0.0
# PORT=8787

# 1 = die App steht hinter Tailscale Serve / Cloudflare Tunnel / Reverse-Proxy
# (liest Client-IP aus Headern, setzt Cookie als "Secure"). Erzwingt ein starkes Passwort.
# TRUST_PROXY=1

# --- Telegram (optional): Post vom Chef aufs Handy, per Antwort neu bearbeiten / erledigen / neuer Auftrag ---
# 1) In Telegram mit @BotFather einen Bot anlegen -> Token hier eintragen
# 2) Hyperstead starten, dem Bot /start schreiben -> er nennt deine Chat-ID -> hier eintragen, neu starten
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Cloud-Upload (optional): Dateien zu GitHub, Google Drive, OneDrive hochladen (Anleitung: docs/cloud.md) ---
# Telegram-Versand (/datei, Knopf ☁️) nutzt die Telegram-Zeilen oben. Anmeldungen bei Google/Microsoft liegen in tokens/.
# GITHUB_UPLOAD_TOKEN=          # Fine-grained Token, nur fuer das Ablage-Repo, Contents: Read and write
# GITHUB_UPLOAD_REPO=           # besitzer/repo, z. B. KhungFu/paperclip-ablage
# GITHUB_UPLOAD_BRANCH=         # leer = Standard-Branch
# GITHUB_UPLOAD_RELEASE=paperclip-ablage   # Release fuer Dateien ueber 50 MB
# GDRIVE_CLIENT_ID=             # Google Cloud: OAuth-Client "Fernseher und Geraete mit begrenzter Eingabe"
# GDRIVE_CLIENT_SECRET=
# GDRIVE_FOLDER_ID=             # optional: Startordner (von Hyperstead angelegt)
# ONEDRIVE_CLIENT_ID=           # entra.microsoft.com: App-Registrierung, oeffentliche Clientflows an
# ONEDRIVE_TENANT=consumers     # common bei Firmenkonten
# PCL_TOKENS_DIR=               # leer = Ordner tokens/ neben .env

# --- YouTube-Kanal (docs/youtube.md): Upload nur nach Freigabe je Video, Anmeldung: python youtube_channel.py login de ---
# YOUTUBE_CLIENT_ID=            # Google Cloud: YouTube Data API v3 an, OAuth-Client "Desktop-App" (bei login --device: "Fernseher und Geraete mit begrenzter Eingabe")
# YOUTUBE_CLIENT_SECRET=

# --- Internet-Werkzeuge der Agenten (Websuche, Seiten lesen, Bilder) ---
# Laufen ohne Key (DuckDuckGo-Suche, Openverse-Bilder, Pollinations-Bildgenerator). Bessere Qualitaet mit eigenem Key:
# PCL_ALLOW_WEB=0            # sperrt ALLE Internet-Werkzeuge serverseitig
# SEARXNG_URL=http://127.0.0.1:8080   # eigene Metasuche (beste Datenschutz-Loesung)
# BRAVE_API_KEY=             # oder TAVILY_API_KEY=
# PEXELS_API_KEY=            # Fotos von Pexels statt Openverse
# IMAGE_PROVIDER=openai      # pollinations (Standard) | gemini (GEMINI_API_KEY) | openai (OPENAI_API_KEY) | openrouter (OPENROUTER_API_KEY) | sdcpp (SDCPP_URL) | nvidia | cloudflare | hf
# OPENAI_API_KEY=            # nur fuer IMAGE_PROVIDER=openai; Referenzbilder laufen ueber den Bearbeiten-Endpunkt (wie ChatGPT)
# OPENROUTER_API_KEY=        # nur fuer IMAGE_PROVIDER=openrouter (ein Guthaben fuer viele Bildmodelle, Std. google/gemini-2.5-flash-image)
# IMAGE_MODEL=               # optional; Standard gemini-2.5-flash-image bzw. gpt-image-1 (neuer bei Gemini: gemini-nano-banana-2.1)
# IMAGE_PROVIDER=nvidia      # NVIDIA_API_KEY, Std. black-forest-labs/flux.1-schnell; 1 Referenzbild mit IMAGE_MODEL=black-forest-labs/flux.1-kontext-dev
# IMAGE_PROVIDER=cloudflare  # CF_ACCOUNT_ID + CF_API_TOKEN, Std. @cf/black-forest-labs/flux-2-klein-4b (bis 4 Referenzbilder), Gratis-Kontingent je Tag
# IMAGE_PROVIDER=hf          # HF_TOKEN, Std. black-forest-labs/FLUX.1-schnell, ohne Referenzbilder; HF_IMAGE_PROVIDER=hf-inference
# IMAGE_PROVIDER=sdcpp + SDCPP_URL=http://192.168.1.50:1234   # eigener Bildrechner (Laptop mit sd-server, docs/laptop-bildrechner.md), gratis, mit Referenzbildern
# SDCPP_SIZE=1024  SDCPP_STEPS=4  SDCPP_CFG=1.0  SDCPP_TIMEOUT=1800   # laengste Bildseite, Schritte, CFG, Zeitlimit in Sekunden
# POLLINATIONS_API_KEY=sk_...   # optional (enter.pollinations.ai, Pollen-Guthaben): neuer Endpunkt, Modell waehlbar, MIT Referenzbildern
# POLLINATIONS_MODEL=           # mit Key Standard black-forest-labs/flux.2-klein-4b; besser, teurer: google/gemini-2.5-flash-image
# IMAGE_STYLE=farbige Buntstiftzeichnung auf Pastellflaeche, sichtbare Strichstruktur   # wird jedem Bild-Prompt vorangestellt
# IMAGE_FALLBACK=pollinations   # optional: schlaegt der gewaehlte Anbieter fehl (Guthaben, Kontingent), kostenloses Ersatzbild OHNE Referenzbilder
# IMAGE_SIZE=                # optional, nur Gemini: 1K | 2K | 4K
# IMAGE_QUALITY=             # optional, nur OpenAI: low | medium | high (high kostet deutlich mehr)
# PCL_MAX_TOOL_STEPS=6
# Videoclips per KI (Werkzeug video_generate, Recht "Medien"). Standard: aus. Jeder Clip kostet Geld beim Anbieter.
# Mehrere Anbieter mit Komma, der erste ist Standard, Agenten koennen mit "provider" einen anderen aus der Liste waehlen.
# Ausfuehrlich mit Kontohinweisen: docs/videodienste.md
# VIDEO_PROVIDER=gemini      # gemini | openai | openrouter | runway | luma | kling | minimax | wan | seedance | higgsfield | fal | replicate
# VIDEO_MODEL=gemini-omni-1.1-flash   # Modell des ERSTEN Anbieters (Veo-3.1-Preview seit 22.10.2026 abgeschaltet); sonst <ANBIETER>_VIDEO_MODEL, z.B. KLING_VIDEO_MODEL=kling-v2-1-master
# PCL_VIDEO_TIMEOUT=900               # Sekunden je Clip
# GEMINI_API_KEY (oben)               # gemini: Veo/Omni, Abrechnung noetig (Flow-/Google-One-Abo zaehlt nicht)
# OPENAI_API_KEY (oben)               # openai: Sora (sora-2, sora-2-pro), ChatGPT-Abo zaehlt nicht
# OPENROUTER_API_KEY (oben)           # openrouter: Std. google/veo-3.1; OPENROUTER_VIDEO_MODEL=minimax/hailuo-3 | alibaba/wan-2.7 | bytedance/seedance-2.0
# RUNWAYML_API_SECRET=                # runway: Std. gen4.5 (API-Credits auf dev.runwayml.com)
# LUMAAI_API_KEY=                     # luma: Std. ray-2, Startbilder nur als https-Adresse
# KLING_ACCESS_KEY=                   # kling: Access Key + Secret Key der Kling-Entwicklerplattform, Std. kling-v2-5-turbo
# KLING_SECRET_KEY=
# KLING_MODE=std                      # std | pro
# MINIMAX_API_KEY=                    # minimax: Std. MiniMax-Hailuo-2.3 (platform.minimax.io)
# DASHSCOPE_API_KEY=                  # wan: Alibaba Model Studio, Std. wan2.2-t2v-plus / WAN_I2V_MODEL=wan2.2-i2v-plus
# ARK_API_KEY=                        # seedance: BytePlus ModelArk, Std. seedance-1-0-pro-250528
# HIGGSFIELD_API_KEY_ID=              # higgsfield: console.higgsfield.ai, Std. minimax/h3/text-to-video (MiniMax H3)
# HIGGSFIELD_API_KEY_SECRET=          #   HIGGSFIELD_VIDEO_MODEL / HIGGSFIELD_I2V_MODEL = Pfad aus der Higgsfield-Doku, z.B. alibaba/wan-3.0/reference-to-video
# FAL_KEY=                            # fal: Std. minimax/h3-max/text-to-video (0,03 $/s), FAL_I2V_MODEL fuer Startbilder (Std. fal-ai/wan/v2.2-a14b/image-to-video)
#   fal-ai/veo3.1/fast = Veo 3.1, das Modell hinter Google Flow (ca. 0,10-0,15 $/s, laut fal bis 17.11.2026)
#   weitere fal-Endpunkte (Preise nicht alle bekannt): fal-ai/kling-video/v3/pro/text-to-video (0,14 $/s), kling/v4/text-to-video,
#   bytedance/seedance-2.0/fast/text-to-video, alibaba/wan-3.0/text-to-video, xai/grok-imagine-video/v1.5/text-to-video
# REPLICATE_API_TOKEN=                # replicate: Std. wan-video/wan-2.2-t2v-fast, REPLICATE_IMAGE_FIELD=image
# FAL_VIDEO_PARAMS={"num_frames": 81} # Zusatzfelder je Anbieter (fal/replicate/openrouter/higgsfield), oder VIDEO_PARAMS fuer alle
#
# KI-Nachbearbeitung (Werkzeug video_ai: upscale, lipsync, sound), nur ueber fal.ai:
# VIDEO_AI=fal                        # + FAL_KEY; Modelle FAL_UPSCALE_MODEL, FAL_LIPSYNC_MODEL, FAL_SOUND_MODEL
# Geraeusche und Musik (Werkzeug sound_generate):
# AUDIO_PROVIDER=elevenlabs           # elevenlabs (ELEVENLABS_API_KEY) | fal (FAL_KEY, FAL_AUDIO_MODEL=fal-ai/stable-audio)
# ELEVENLABS_API_KEY=
# --- Medien (Video, Sprache, Dokumente) ---
# Systempakete: sudo apt install ffmpeg espeak-ng fonts-dejavu-core
# TTS_ENGINE=auto            # auto | espeak | piper | edge | elevenlabs | openai (Cloud-Stimmen kosten pro Zeichen)
# Bessere Stimmen bei Bedarf: nur ELEVENLABS_API_KEY setzen (oben), TTS_ENGINE auf auto lassen. Dann bleibt alles lokal/gratis,
# und die Agenten nehmen ElevenLabs nur dort, wo es gut klingen muss (engine: elevenlabs, auch je Filmfigur).
# TTS_ENGINE=elevenlabs heisst dagegen: IMMER ElevenLabs.
# ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb   # Standardstimme bei ElevenLabs (Stimmen-ID), ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# TTS_FALLBACK=1             # 1 = klappt die Cloud-Stimme nicht (Key, Guthaben, Netz), spricht die lokale Stimme; 0 = Aufgabe bricht ab
# OPENAI_TTS_VOICE=alloy     # bei TTS_ENGINE=openai: alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer ... OPENAI_TTS_MODEL=gpt-4o-mini-tts
# PIPER_MODEL=/pfad/zur/stimme.onnx   # Piper = deutlich bessere Offline-Stimme als espeak (pip install piper-tts)
# EDGE_VOICE=de-AT-IngridNeural       # nur mit TTS_ENGINE=edge und pip install edge-tts (inoffizieller Online-Dienst)
# PCL_FFMPEG_TIMEOUT=3600    # Sekunden je Videoschritt (Pi ist langsam: 1 Min Video = mehrere Minuten Rechenzeit)
# PCL_MAX_UPLOAD_MB=500      # Upload-Limit fuer eigene Dateien
# PCL_MAX_DOWNLOAD_MB=60     # Limit fuer Downloads der Agenten (PDFs, Medien)
# PCL_MAX_OUTPUT=0           # max. Ausgabe-Tokens je Modellantwort (0 = Standard, Claude: 8192)

# --- Echter Browser (browse_page, Recht "web"): ./install.sh --browser ---
# PCL_BROWSER=0              # 0 = Browser-Werkzeug aus, auch wenn Playwright installiert ist
# PCL_BROWSER_PATH=/usr/bin/chromium   # eigenes Chromium statt dem von Playwright (z. B. 32-Bit-System)
# PCL_MACROS=1               # Browser-Makros (Werkzeug site_macro) fuer MagicLight, Google Flow usw. mit deinem Konto, siehe macros/README.md
# PCL_MACRO_TIMEOUT=3600     # Sekunden je Makro-Lauf (lange MagicLight-Videos brauchen viel Zeit)
# PCL_BROWSER_TIMEOUT=30     # Sekunden je Seite

# --- Code ausfuehren (Recht "run_code", je Agent einschalten): ./install.sh --run (bubblewrap) ---
# Abgeschottet: kein Internet, nur /usr und der Projektordner (nur lesen) sichtbar, keine Keys, Ergebnisse in output/run/
# PCL_ALLOW_RUN=0            # 0 = global gesperrt
# PCL_RUN_TIMEOUT=60         # Sekunden je Lauf
# PCL_RUN_MEM_MB=1024        # RAM-Grenze je Lauf (Adressraum)

# --- Rust-Programme komplett bauen (Werkzeug rust_project, gehoert zum Recht "run_code") ---
# Braucht cargo (rustup.rs). Linux/Pi: baut und testet in bubblewrap (kein Internet, keine Keys); nur cargo fetch laedt aus crates.io.
# PCL_CARGO=0                # 0 = Rust-Werkzeug aus
# PCL_CARGO_PATH=/home/pi/.cargo/bin/cargo   # nur falls cargo nicht gefunden wird
# PCL_CARGO_TIMEOUT=900      # Sekunden je Bau-Schritt (der Pi ist langsam)
# PCL_CARGO_MEM_MB=3072      # RAM-Grenze je Compiler-Prozess (Adressraum, nur Linux)
# PCL_CARGO_JOBS=2           # parallele Compiler-Prozesse (weniger = weniger RAM)
# Ohne bubblewrap (Windows) nur mit diesem Schalter, dann OHNE Abschottung: der Code der Agenten sieht deine Dateien!
# PCL_CARGO_UNSAFE=1

# --- Gefaehrliche Faehigkeiten (Standard: aus) ---
# Shell-Befehle nach manueller Freigabe ausfuehren. Wer das Passwort hat, kann dann Befehle auf dem Pi freigeben!
# PCL_ALLOW_SHELL=1
# CLI-Agenten (z.B. "claude -p") erlauben
# PCL_ALLOW_CLI=1
# Eingebaute CLI-Anbieter nutzen dein Abo statt API-Key (Programme muessen auf dem Pi installiert und angemeldet sein):
#   "Claude (CLI)"  -> claude -p --tools "" --strict-mcp-config --no-session-persistence         (Befehl aenderbar: PCL_CLI_CLAUDE=...)
#   "ChatGPT (Codex-CLI)" -> codex exec --skip-git-repo-check --ephemeral -     (Befehl aenderbar: PCL_CLI_CODEX=...)
# PCL_CLI_TIMEOUT=600         # Sekunden je Antwort
# Eigene Verbindungen der KI (MCP), Anleitung docs/ki-verbindungen.md:
#   Konnektoren aus deinem claude.ai-Abo (Namen wie auf claude.ai, Komma-getrennt):
# PCL_CLAUDE_CONNECTORS=Canva
#   Eigene MCP-Server: Datei tokens/claude-mcp.json im Format {"mcpServers": {...}} (Zugangsdaten nur dort, nie im Repo)
# PCL_CLAUDE_MCP=/anderer/pfad/claude-mcp.json
#   Codex nimmt seine Server aus ~/.codex/config.toml ([mcp_servers.<name>]).

# --- Werkstatt: Agenten arbeiten wie an einem echten Rechner (Standard: aus) ---
# Mit Recht "Werkstatt" je Agent: Befehle im Projektordner (Werkzeug befehl), Claude/Codex mit ihren eigenen Werkzeugen,
# fehlende Programme per Antrag: Mitarbeiter -> CEO prueft -> du bestaetigst (Web oder Telegram-Knopf) -> Server installiert.
# Laeuft OHNE Abschottung mit deinen Benutzerrechten. Anleitung: docs/werkstatt.md
# PCL_ALLOW_WERKSTATT=1
# PCL_WERKSTATT_FREI=1        # erlaubt Stufe 3 (alles ohne Nachfrage); ohne den Schalter gilt Stufe 3 wie Stufe 2
# PCL_BEFEHL_TIMEOUT=600      # Sekunden je Befehl eines Agenten
# PCL_NACHRUEST_TIMEOUT=1800  # Sekunden je freigegebener Installation
# PCL_NACHRUEST_MAX=6         # Antraege je Aufgabe
# PCL_WERKSTATT_TIMEOUT=3600  # Sekunden je Claude-/Codex-Lauf mit eigenen Werkzeugen

# Maximale Delegationstiefe (CEO -> CTO -> Dev -> ...)
# PCL_MAX_DEPTH=8

# --- OCR (gescannte PDFs und Bilder lesen; braucht: sudo apt install tesseract-ocr tesseract-ocr-deu poppler-utils) ---
# PCL_OCR_LANG=deu+eng        # Standard: alle installierten aus deu, eng, tur
# PCL_OCR_MAX_PAGES=25        # Seiten je Scan (OCR ist auf dem Pi langsam, ca. 5-15 s/Seite)
# PCL_OCR_IMAGES=0            # 0 = Bilder nicht per OCR lesen
# PCL_RUN_MAX_IMAGES=8        # Bilder, die ein Agent in einem Auftrag gleichzeitig sieht (view_image, Selbstkontrolle)
# PCL_SELF_CHECKS=1           # erzeugte PDFs als Bild gegen den Auftrag pruefen lassen (0 = aus)

# --- Sprachausgabe: Piper wird nach "./install.sh --piper" automatisch genutzt (models/piper/*.onnx) ---
# TTS_ENGINE=auto             # auto | piper | espeak | edge
# PIPER_MODEL=/pfad/zur/stimme.onnx   # nur noetig fuer eine andere Stimme
